# Base URL for the Plaid backend routes (see lava_money_web/app/api/plaid/).
# Production: the deployed lava_money_web URL, e.g. https://www.lavamoney.io
# Local dev-client testing: your Mac's LAN IP + the port `next dev` printed
# (a phone/simulator can't reach `localhost` on your Mac) --
# e.g. http://10.0.0.180:3001
EXPO_PUBLIC_API_BASE_URL="https://www.lavamoney.io"
